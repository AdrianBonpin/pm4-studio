{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM4 Studio",
  "version": "0.1.0",
  "identifier": "com.adrianbonpin.pm4studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PM4 Studio",
        "width": 980,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "backgroundColor": "#0B0D10",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
